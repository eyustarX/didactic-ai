# ===========================================================================
# Didactic AI - Environment Configuration
# ===========================================================================
# Copy this file to '.env' and fill in your configuration:
#   cp .env.example .env

# Server & Application Settings
PROJECT_NAME="Didactic AI"
ENVIRONMENT="development"
DEBUG=True
DATABASE_URL="sqlite:///./didactic.db"
STORAGE_DIR="./storage"

# ===========================================================================
# AI Engine Configuration (Google Gemini)
# ===========================================================================
# Get your free Google Gemini API key at: https://aistudio.google.com/
# Leave empty to run 100% offline using the built-in deterministic simulator.
GEMINI_API_KEY=""
